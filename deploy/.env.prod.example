# Production environment template — AI PR Reviewer (ticket 13).
#
# Copy to deploy/.env and fill in real values. deploy/.env is gitignored —
# NEVER commit it, and never paste real secrets into tickets or logs.
# Compose reads this file twice: for ${...} interpolation and as env_file.
#
#   cp deploy/.env.prod.example deploy/.env
#   chmod 600 deploy/.env

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── Required: database password (interpolated into DATABASE_URL by compose) ──
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Host port for LOCAL smoke runs only (deploy/docker-compose.local.yml) ───
# Production publishes no host ports: Dokploy Traefik routes to container
# port 3000 over dokploy-network. Set the domain's Container Port to 3000
# in the Dokploy Domains tab.
PROBOT_PORT=3000

# ── Dokploy ingress network (§18.3). Default matches Dokploy's created name ──
# Check on the host: docker network ls | grep dokploy
DOKPLOY_NETWORK=dokploy-network

# ── GitHub App (§14.1). WEBHOOK_URL is shown in the GitHub App settings and
# must be https://<your-domain>/ — the probot webhook endpoint. ───────────────
APP_ID=
WEBHOOK_SECRET=
# GitHub App private key — set exactly ONE of the three:
# (a) single-line base64 of the PEM (deployment-friendly, e.g. Dokploy):
# GITHUB_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTi...
# (b) raw PEM (multiline — quote it if your env file supports multiline):
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----"
# (c) path to a PEM file available inside the container:
# GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.private-key.pem

# ── Admin API OAuth (ticket 10 — optional; admin endpoints 503 when unset) ──
# Create a SEPARATE GitHub OAuth App for admin login (not the App install).
ADMIN_OAUTH_CLIENT_ID=
ADMIN_OAUTH_CLIENT_SECRET=
# e.g. https://<your-domain>/api/admin/auth/github/callback
ADMIN_OAUTH_CALLBACK_URL=
SESSION_SECRET=
ADMIN_GITHUB_ORG=
# Comma-separated admin logins (empty = rely on org admin roles)
ADMIN_GITHUB_LOGINS=

# ── Model provider (ticket 05). MODEL_API_KEY names the env var that holds
# the secret key value (provider.apiKeyEnv indirection — the raw key never
# appears in config files). MODEL_NAME must be the "provider/model" form. ─────
MODEL_API_KEY=
MODEL_NAME=workers-ai/@cf/zai-org/glm-4.7-flash
MODEL_BASE_URL=https://llm.nativewit.app/compat

# ── Backups (§17.2) ──────────────────────────────────────────────────────────
# Hours between pg_dump runs / retention window / staleness alarm threshold.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26
BACKUP_RUN_ON_START=1

# ── Review config env references (config/review.json uses ${VAR} forms) ──────
# Only needed if your config/review.json overrides reference extra env vars.
