# Application
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# Dependencies (required in production; defaults target localhost)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reviewer
REDIS_URL=redis://localhost:6379

# GitHub App credentials (secret — never commit real values)
APP_ID=
WEBHOOK_SECRET=
PRIVATE_KEY=
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET reserved for admin OAuth (ticket 10)

# Admin API (ticket 10, §14.2 — optional; admin endpoints return 503 when unset)
# GitHub OAuth app used ONLY for admin identity (separate from the App installation)
ADMIN_OAUTH_CLIENT_ID=
# Secret — never commit real values; never logged
ADMIN_OAUTH_CLIENT_SECRET=
# Absolute URL GitHub redirects back to, e.g. https://admin.example.com/api/admin/auth/github/callback
ADMIN_OAUTH_CALLBACK_URL=http://localhost:3000/api/admin/auth/github/callback
# Random >=16 char secret used to sign session cookies
SESSION_SECRET=
# GitHub organization members allowed to authenticate
ADMIN_GITHUB_ORG=
# Comma-separated GitHub logins that are administrators (empty = use org roles below)
ADMIN_GITHUB_LOGINS=
# Organization roles granting admin access when ADMIN_GITHUB_LOGINS is empty
ADMIN_ORG_ADMIN_ROLES=admin
# Session lifetime and admin API rate limit
SESSION_TTL_SECONDS=28800
ADMIN_RATE_LIMIT_PER_MINUTE=60

# Model provider (ticket 05)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Review config env references (ticket 02; see config/review.json)
# MODEL_BASE_URL is required by the sample config via ${MODEL_BASE_URL}
# MODEL_API_KEY is the env var NAME referenced by provider.apiKeyEnv
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=GROQ_API_KEY

# Agent tracing (optional, disabled by default). Enable it with
# observability.langfuse.enabled = true in config/review.json, then set the
# credentials below. The OpenCode Langfuse plugin ships session traces
# (prompts, generations, tool calls, errors, tokens) to Langfuse; the worker
# itself only logs lifecycle events. PRIVACY: traces may include repository
# content — start with a restricted repository and agree retention/access
# before enabling in production. Secrets are never written to opencode.json.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted: https://langfuse.example.com — Cloud: https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=production

# Development only: webhook proxy for local GitHub App testing
WEBHOOK_PROXY_URL=

# Knowledge sources (review types `skill` / `handbook`; §4.5 in docs/architecture.md)
# Fetched ONCE at worker startup and cached in a persistent volume — never per review.
# Persistent cache directory for skill + handbook content (volume-mount in prod).
KNOWLEDGE_CACHE_DIR=
# Ref overrides (commit SHA or tag). Pin SHAs in production — refs from config are
# only defaults; a moving ref silently changes review findings.
KNOWLEDGE_SKILL_REF=
KNOWLEDGE_HANDBOOK_REF=
# GitHub token for PRIVATE source repos (e.g. the handbook). Public repos fetch
# unauthenticated; falls back to GITHUB_TOKEN when unset.
KNOWLEDGE_GITHUB_TOKEN=

# Worker / runtime (all optional; defaults target local development)
# Private key for the worker's GitHub App token minting (the worker process is
# separate from Probot and cannot use PRIVATE_KEY). Set exactly ONE form.
GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
# GITHUB_PRIVATE_KEY_BASE64=
# Root directory for per-review clones/workspaces (volume-mount in prod)
WORKSPACE_ROOT_DIR=
# Path to the OpenCode CLI binary if not on PATH
OPENCODE_BINARY_PATH=
# Metrics HTTP server bind (observability/metrics-endpoint)
METRICS_HOST=
METRICS_PORT=
# Stale-review threshold (ms) for startup reconciliation/recovery
RECOVERY_STALE_THRESHOLD_MS=
# Docker sandbox execution (execution.sandbox.enabled in config/review.json)
SANDBOX_DOCKER_HOST=
SANDBOX_DOCKER_NETWORK=
